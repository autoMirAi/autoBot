HOST=0.0.0.0
PORT=8080
DRIVER=~fastapi
LOG_LEVEL=INFO

# 必须与 NapCat WebSocket 客户端 Token 相同。
ONEBOT_ACCESS_TOKEN=replace-with-a-long-random-token

# 逗号分隔；为空表示允许所有群进行只读问答。
ALLOWED_GROUP_IDS=

# 逗号分隔；只有这些 QQ 可以使用 /do。
OPERATOR_QQ_IDS=

CODEX_BIN=/usr/local/bin/codex
CODEX_MODEL=deepseek-v4-flash
CODEX_REASONING_EFFORT=low
CODEX_HOME=/run/autobot-codex
CODEX_WORKDIR=/data/40winters/autobot-workspace
AUTOBOT_STATE_DIR=/data/40winters/autoBot/data
CODEX_TIMEOUT_SECONDS=300
# 不同群/私聊最多并行两个任务；同一会话始终串行。
MAX_PARALLEL_TASKS=2
MAX_PROMPT_CHARS=6000
MAX_REPLY_CHARS=3500
# 长会话自动创建新 Codex thread，并将近期历史作为受限上下文带入。
CODEX_SESSION_MAX_TURNS=8
CODEX_CONTEXT_HISTORY_TURNS=4
CODEX_CONTEXT_HISTORY_CHARS=8000

# Windows ComfyUI video worker. Generate a random token; never commit the real value.
VIDEO_ENABLED=false
VIDEO_WORKER_TOKEN=
VIDEO_PUBLIC_BASE_URL=http://host.docker.internal:8080
VIDEO_OUTPUT_DIR=/data/40winters/autoBot/data/video
VIDEO_MAX_PROMPT_CHARS=1200
VIDEO_MAX_FILE_BYTES=83886080
# Local MiniMax H3 is GPU-intensive, so conservative quotas are enabled by default.
VIDEO_MAX_QUEUED=10
VIDEO_CLAIM_LEASE_SECONDS=90
VIDEO_JOB_TIMEOUT_SECONDS=1800
VIDEO_FILE_TTL_SECONDS=86400
VIDEO_MAX_DURATION_SECONDS=30
